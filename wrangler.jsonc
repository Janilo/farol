{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "farol",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [{ "pattern": "farol.pereirasaraiva.com", "custom_domain": true }],
  "vars": {
