    "SUPABASE_URL": "https://sscnhpcyvcsgtacundgc.supabase.co",
    "SUPABASE_PROJECT_ID": "sscnhpcyvcsgtacundgc",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_Nog8EYSMeMHD9I6TQjPY3A_QizWblz7",
  },
}
